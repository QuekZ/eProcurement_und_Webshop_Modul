<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>
<h1>Verhandlungen &amp; Verträge</h1>
<p class="muted">Der Verhandlungsagent antwortet automatisch (Mittelwert-Strategie, Preisuntergrenze, Mengenrabatt, max. 3 Runden). Hier kann der Vertrieb manuell eingreifen.</p>
<section class="panel">
<table class="table">
  <tr><th>#</th><th>Kunde</th><th>Produkt</th><th>Menge</th><th>Liste / Untergrenze</th><th>Aktuell</th><th>Status</th><th>Manuell entscheiden</th></tr>
  <% list.forEach((n) => { %>
  <tr>
    <td>#<%= n.id %></td><td><%= n.company || n.customer %></td><td><%= n.product_name %></td><td><%= n.quantity %></td>
    <td><%= eur(n.list_price) %> / <%= eur(n.min_price) %></td><td><%= eur(n.current_price) %></td>
    <td><span class="status s-<%= n.status %>"><%= n.status %></span></td>
    <td><% if (['offen', 'gegenangebot'].includes(n.status)) { %>
      <form method="post" action="/admin/verhandlungen/<%= n.id %>" class="inline">
        <input type="number" step="0.01" name="price" value="<%= n.current_price %>" class="qty wide">
        <select name="decision"><option value="gegenangebot">Gegenangebot</option><option value="angenommen">Annehmen</option><option value="abgelehnt">Ablehnen</option></select>
        <button class="btn small">OK</button>
      </form>
    <% } %></td>
  </tr>
  <% }) %>
</table>
</section>
<section class="panel">
  <h2>Kontraktüberwachung</h2>
  <table class="table">
    <tr><th>Vertrag</th><th>Kunde</th><th>Produkt</th><th>Menge</th><th>Summe</th><th>Liefertermin</th><th>Status</th></tr>
    <% contracts.forEach((k) => { const late = k.status !== 'erfuellt' && new Date(k.delivery_date) < new Date(); %>
      <tr class="<%= late ? 'highlight' : '' %>"><td><%= k.contract_no %></td><td><%= k.customer %></td><td><%= k.product_name %></td><td><%= k.quantity %></td>
        <td><%= eur(k.total) %></td><td><%= date(k.delivery_date) %><%= late ? ' ⚠ überfällig' : '' %></td><td><span class="status s-<%= k.status %>"><%= k.status %></span></td></tr>
    <% }) %>
  </table>
</section>
<%- include('../partials/footer') %>
